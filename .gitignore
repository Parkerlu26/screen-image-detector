# 依賴與建置產物
node_modules/
build/
dist/
coverage/
*.log

# 打包輸出（exe 以 GitHub Release 附件發布，不進版控）
release/
*.exe
*.7z

# 機密與本機設定
.env*
!.env.example
*key*.txt
# Cloudflare Worker 的本機機密與本機 D1 資料
server/.dev.vars
server/.wrangler/
# wrangler.toml 含有自己的 D1 database_id，範本是 wrangler.toml.example
server/wrangler.toml

# 編輯器 / 工具暫存
.DS_Store
.antigravity/
scratch/
# codegraph 的 SQLite 索引，是本機工具重建得出來的產物
.codegraph/
